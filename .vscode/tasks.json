{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Solution with MSBuild",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}\\Builds\\VisualStudio2022\\AdaptiveMetronome.sln",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/m"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the .sln using MSBuild",
            "options": {
                "cwd": "${workspaceFolder}"
            },
        }
    ]
}
